--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -2237,6 +2237,20 @@
 	uint64_t cntvctl = CNTV_CTL_EL0_ENABLE; /* One wants to use 32 bits, but "mrs" prefers it this way */
 
 	__builtin_arm_wsr64("CNTV_CTL_EL0", cntvctl);
+#if defined(SWEET)
+	/*
+	 * The Venus trial faults on the physical timer control access.  The
+	 * Venus DTB and GIC route the virtual
+	 * timer (PPI 19), and the SWEET interrupt path uses that timer only.
+	 * Do not issue the Apollo/SWEET precautionary CNTP_CTL_EL0 write on a
+	 * Venus boot; it raises the early undefined-instruction panic at
+	 * _fiq_context_init.  Other SWEET targets retain the original mask.
+	 */
+	uint32_t venus = 0;
+	if (PE_parse_boot_argn("venus", &venus, sizeof(venus)) && venus) {
+		return;
+	}
+#endif /* SWEET */
 	/* disable the physical timer as a precaution, as its registers reset to architecturally unknown values */
 	__builtin_arm_wsr64("CNTP_CTL_EL0", CNTP_CTL_EL0_IMASKED);
 }
